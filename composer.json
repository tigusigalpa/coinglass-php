{
    "name": "tigusigalpa/coinglass-php",
    "description": "A modern, framework-agnostic PHP SDK for the Coinglass API v4, with first-class Laravel 10, 11, 12 & 13 integration.",
    "type": "library",
    "keywords": [
        "coinglass",
        "crypto",
        "futures",
        "derivatives",
        "sdk",
        "laravel",
        "api-client"
    ],
    "homepage": "https://github.com/tigusigalpa/coinglass-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Igor Sazonov",
            "email": "sovletig@gmail.com",
            "homepage": "https://github.com/tigusigalpa"
        }
    ],
    "support": {
        "issues": "https://github.com/tigusigalpa/coinglass-php/issues",
        "source": "https://github.com/tigusigalpa/coinglass-php"
    },
    "require": {
        "php": "^8.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "guzzlehttp/guzzle": "^7.15.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "suggest": {
        "illuminate/support": "Required to use the Laravel service provider and facade (^10.0 || ^11.0 || ^12.0 || ^13.0).",
        "ext-openssl": "Required to connect to the wss:// WebSocket API."
    },
    "autoload": {
        "psr-4": {
            "Tigusigalpa\\CoinGlass\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tigusigalpa\\CoinGlass\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tigusigalpa\\CoinGlass\\Laravel\\CoinGlassServiceProvider"
            ],
            "aliases": {
                "CoinGlass": "Tigusigalpa\\CoinGlass\\Laravel\\Facades\\CoinGlass"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
